# AI Chat App - Environment Configuration
# Copy this file to .env and update with your values

# =================================
# Application Configuration
# =================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# =================================
# Database Configuration (MariaDB)
# =================================
DB_HOST=192.168.1.206
DB_PORT=3306
DB_USER=ChatterRaveUser
DB_PASSWORD=your_database_password_here
DB_NAME=ChatterRave

# =================================
# Authentication & Security
# =================================
# Generate a secure JWT secret: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_change_this_to_something_very_secure_and_random

# =================================
# AI Services
# =================================
LOCALAI_URL=http://192.168.1.206:8082
A1111_URL=http://192.168.1.206:7860
AUTOMATIC1111_URL=http://192.168.1.206:7860
COMFYUI_URL=http://192.168.1.206:8188

# =================================
# Docker Management (SSH to AI host)
# =================================
DOCKER_SSH_HOST=192.168.1.206
DOCKER_SSH_PORT=22
DOCKER_SSH_USER=root
DOCKER_SSH_PASS=your_ssh_password_here
# Or use SSH key:
# DOCKER_SSH_KEY_PATH=/path/to/private/key

# Docker Container Names
DOCKER_CONTAINER_LOCALAI=local-ai
DOCKER_CONTAINER_A1111=AUTOMATIC1111-Stable-Diffusion-Web-UI
DOCKER_CONTAINER_COMFYUI=comfyui

# =================================
# Optional: Rate Limiting
# =================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100